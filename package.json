{
  "name": "lingora",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25", "pnpm": ">=11 <12" },
  "scripts": {
    "dev": "pnpm --filter @lingora/web dev",
    "build": "pnpm --filter @lingora/web build",
    "lint": "pnpm --filter @lingora/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @lingora/web test",
    "test:e2e": "pnpm --filter @lingora/web test:e2e",
    "api:generate": "uv run --project apps/api python apps/api/scripts/export_openapi.py && pnpm --filter @lingora/api-client generate"
  }
}
