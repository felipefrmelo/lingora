# Public build-time configuration. Never add secrets or private tokens here.
# Empty uses the current origin; Vite proxies /api to localhost:8000 in development.
VITE_API_BASE_URL=

# Reserved for Milestone 2; not required to start this foundation.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/auth/callback
