# Local development only. Production credentials belong in a secret manager.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lingora:lingora_local@localhost:5432/lingora
TEST_DATABASE_URL=postgresql+psycopg://lingora:lingora_test_local@localhost:5433/lingora_test
CORS_ORIGINS=["http://localhost:5173"]
DB_READY_TIMEOUT_SECONDS=2
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional as a complete group. Not needed for health checks or ordinary tests.
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_API_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_EMAIL_VERIFIED_CLAIM=https://lingora.local/api/email_verified
AUTH0_JWKS_CACHE_SECONDS=300
AUTH0_JWKS_TIMEOUT_SECONDS=5

# Server/worker only; never put an API key in VITE_ variables.
OPENAI_API_KEY=
LESSON_MODEL=gpt-5-mini-2025-08-07
LESSON_TIMEOUT_SECONDS=120

# MCP is a separate listener and remains unavailable until both values are configured.
MCP_RESOURCE_URL=
MCP_ALLOWED_CLIENTS=[]
