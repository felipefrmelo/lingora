# Local development only. Production credentials belong in a secret manager.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lingora:lingora_local@localhost:5432/lingora
TEST_DATABASE_URL=postgresql+psycopg://lingora:lingora_test_local@localhost:5433/lingora_test
CORS_ORIGINS=["http://localhost:5173"]
DB_READY_TIMEOUT_SECONDS=2
OTEL_EXPORTER_OTLP_ENDPOINT=

# Reserved for Milestone 2. Not needed for health checks or ordinary tests.
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_API_AUDIENCE=
AUTH0_JWKS_URL=

# Reserved for Milestone 5; must identify a separate MCP resource.
MCP_RESOURCE_URL=
AUTH0_MCP_AUDIENCE=
